API_URL=http://YOUR_API_HOST:4000
NODE_ID=seed-node-us
# Must equal NODE_AGENT_SECRET in api/.env
NODE_AGENT_SECRET=change-me-node-agent-secret
POLL_INTERVAL_MS=10000
# Heartbeat with peer handshakes (admin "agent online" + stale-session cleanup)
REPORT_INTERVAL_MS=30000
WG_BIN=wg
DRY_RUN=false
# Remove WireGuard peers the API does not know about (stale or deleted). Set false to only add/remove queued peers.
PRUNE_UNKNOWN_PEERS=true
# Comma-separated public keys that are never pruned (e.g. your own static admin peer)
KEEP_PEERS=
