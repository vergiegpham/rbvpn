{
  "name": "rbvpn-windows",
  "version": "6.11.5",
  "private": true,
  "license": "MIT",
  "description": "RB-VPN Windows client",
  "author": "RB-VPN",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "version:date": "node scripts/set-version-from-date.js",
    "prepare:runtime": "node scripts/prepare-runtime.js",
    "cert:create": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/create-code-signing-cert.ps1",
    "dist": "npm run version:date && npm run prepare:runtime && electron-builder --win",
    "dist:msi": "npm run version:date && npm run prepare:runtime && electron-builder --win --config.directories.output=dist-msi",
    "dist:dir": "npm run version:date && npm run prepare:runtime && electron-builder --win --dir"
  },
  "dependencies": {
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "electron": "^34.5.8",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.rbvpn.client",
    "productName": "RB-VPN",
    "copyright": "Copyright © RB-VPN",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/tunnel/WireGuard",
        "to": "tunnel/WireGuard"
      },
      {
        "from": "vendor/tunnel/rbvpn-network-runtime.msi",
        "to": "tunnel/rbvpn-network-runtime.msi"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "requestedExecutionLevel": "requireAdministrator",
      "signAndEditExecutable": true,
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ]
      },
      "target": [
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "RB-VPN-Setup-${version}.${ext}"
    },
    "msi": {
      "oneClick": false,
      "perMachine": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    },
    "msiProjectCreated": "./build/msiProjectCreated.js"
  }
}
