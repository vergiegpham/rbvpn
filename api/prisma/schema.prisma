generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  name         String?
  role         String         @default("user")
  suspended    Boolean        @default(false)
  suspendedAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  subscriptions Subscription[]
  devices      Device[]
  payments     Payment[]
}

model Plan {
  id           String         @id @default(cuid())
  code         String         @unique
  name         String
  description  String
  priceCents   Int
  currency     String         @default("usd")
  durationDays Int
  maxDevices   Int            @default(1)
  stripePriceId String?
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  subscriptions Subscription[]
  payments     Payment[]
}

model Subscription {
  id        String   @id @default(cuid())
  userId    String
  planId    String
  status    String   @default("active")
  startsAt  DateTime @default(now())
  endsAt    DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      Plan     @relation(fields: [planId], references: [id])

  @@index([userId])
  @@index([status])
}

model VpnNode {
  id            String   @id @default(cuid())
  name          String
  region        String
  publicHost    String
  publicPort    Int      @default(51820)
  publicKey     String
  interfaceName String   @default("wg0")
  subnetCidr    String   @default("10.10.0.0/24")
  gatewayIp     String   @default("10.10.0.1")
  nextClientIp  Int      @default(2)
  capacity      Int      @default(250)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  devices       Device[]
}

model Device {
  id               String   @id @default(cuid())
  userId           String
  nodeId           String
  name             String
  clientPrivateKey String
  clientPublicKey  String
  clientIp         String
  syncStatus       String   @default("pending")
  lastSeenAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  node             VpnNode  @relation(fields: [nodeId], references: [id])

  @@index([userId])
  @@index([nodeId])
  @@index([syncStatus])
}

model Payment {
  id              String   @id @default(cuid())
  userId          String
  planId          String
  provider        String
  providerRef     String?
  amountCents     Int
  currency        String
  status          String   @default("pending")
  rawPayload      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan            Plan     @relation(fields: [planId], references: [id])

  @@index([userId])
  @@index([providerRef])
  @@index([status])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  status    String   @default("new")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}
