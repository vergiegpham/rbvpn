PORT=4000
DATABASE_URL="postgresql://rbvpn:rbvpn@127.0.0.1:5432/rbvpn?schema=public"
# Long random string (32+ chars), e.g. `openssl rand -base64 48`. Changing it signs everyone out.
JWT_SECRET=change-me-to-a-long-random-string
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# First admin, created by `npm run db:seed` only when no admin exists.
# Without ADMIN_PASSWORD a random one is generated and printed once.
ADMIN_EMAIL=admin@rbvpn.local
ADMIN_PASSWORD=

# Stripe (card). Both keys are required for card checkout.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_BASIC=price_xxx
STRIPE_PRICE_PRO=price_xxx
STRIPE_PRICE_BASIC_ANNUAL=price_xxx
STRIPE_PRICE_PRO_ANNUAL=price_xxx

# NOWPayments (crypto). Both keys are required; the IPN secret verifies payment callbacks.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_SANDBOX=true

# Local testing only: checkout for unconfigured providers activates plans without charging.
# Never enable on a public server.
ALLOW_MOCK_PAYMENTS=false

# Shared secret for VPN node agents (32+ chars; must match each server/vpn-agent/.env)
NODE_AGENT_SECRET=change-me-node-agent-secret

# Free the VPN IP of sessions with no WireGuard handshake for this many hours (0 = never).
STALE_SESSION_HOURS=24

# Starter node created by the seed on an empty database
SEED_NODE_HOST=
SEED_NODE_PORT=51820
SEED_NODE_PUBLIC_KEY=

# InterServer (purchase VPS from admin panel)
# Password can be your portal password OR an API key from my.interserver.net/account_security
INTERSERVER_USERNAME=
INTERSERVER_PASSWORD=
