{
  "name": "rbvpn-windows",
  "version": "1.0.0",
  "private": true,
  "description": "RB-VPN Windows client",
  "author": "RB-VPN",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "prepare:runtime": "node scripts/prepare-runtime.js",
    "dist": "npm run prepare:runtime && electron-builder --win",
    "dist:dir": "npm run prepare:runtime && electron-builder --win --dir"
  },
  "dependencies": {
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "electron": "^34.5.8",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.rbvpn.client",
    "productName": "RB-VPN",
    "copyright": "Copyright © RB-VPN",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/tunnel",
        "to": "tunnel",
        "filter": [
          "rbvpn-network-runtime.msi"
        ]
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "requestedExecutionLevel": "requireAdministrator",
      "signAndEditExecutable": true,
      "target": [
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "RB-VPN-Setup-${version}.${ext}"
    },
    "msi": {
      "oneClick": false,
      "perMachine": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    }
  }
}
